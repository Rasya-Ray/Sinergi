[Unit]
Description=NESTI Security Scanner (Python)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/NESTI/python
Environment=PATH=/root/NESTI/python/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/root/NESTI/python/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
